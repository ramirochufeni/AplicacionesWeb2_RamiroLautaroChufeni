---
const anio = new Date().getFullYear();
---

<footer class="bg-slate-900 text-white mt-auto">
    <div class="max-w-6xl mx-auto px-4 py-10">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- Información de RamaTech -->
            <div>
                <h2 class="text-2xl font-bold mb-3">
                    RamaTech
                </h2>

                <p class="text-gray-300 max-w-md">
                    Servicio técnico de computadoras y venta de
                    componentes informáticos. Encontrá los productos
                    que necesitás para tu computadora.
                </p>
            </div>

            <!-- Enlaces de navegación -->
            <div class="md:text-right">
                <h3 class="text-lg font-semibold mb-3">
                    Enlaces rápidos
                </h3>

                <nav class="flex flex-col gap-2 md:items-end">
                    <a href="/" class="text-gray-300 hover:text-blue-300">
                        Inicio
                    </a>

                    <a href="/productos" class="text-gray-300 hover:text-blue-300">
                        Productos
                    </a>

                    <a href="/carrito" class="text-gray-300 hover:text-blue-300">
                        Mi carrito
                    </a>

                    <a href="/login" class="text-gray-300 hover:text-blue-300">
                        Iniciar sesión
                    </a>

                    <a href="/registro" class="text-gray-300 hover:text-blue-300">
                        Crear cuenta
                    </a>
                </nav>
            </div>

        </div>

        <!-- Derechos de autor -->
        <div class="border-t border-slate-700 mt-8 pt-6 text-center">
            <p class="text-gray-400 text-sm">
                © {anio} RamaTech. Todos los derechos reservados.
            </p>
        </div>

    </div>
</footer>

<div class="mb-8">
    <h2 class="text-lg font-semibold mb-3">
        Filtrar por categoría
    </h2>

    <div class="flex flex-wrap gap-3">
        <button
            class="filtro-categoria bg-slate-900 text-white px-4 py-2 rounded-md cursor-pointer"
            data-categoria=""
        >
            Todos
        </button>

        <button
            class="filtro-categoria bg-white px-4 py-2 rounded-md shadow cursor-pointer"
            data-categoria="Memorias"
        >
            Memorias
        </button>

        <button
            class="filtro-categoria bg-white px-4 py-2 rounded-md shadow cursor-pointer"
            data-categoria="Almacenamiento"
        >
            Almacenamiento
        </button>

        <button
            class="filtro-categoria bg-white px-4 py-2 rounded-md shadow cursor-pointer"
            data-categoria="Perifericos"
        >
            Periféricos
        </button>

        <button
            class="filtro-categoria bg-white px-4 py-2 rounded-md shadow cursor-pointer"
            data-categoria="Fuentes"
        >
            Fuentes
        </button>
    </div>
</div>
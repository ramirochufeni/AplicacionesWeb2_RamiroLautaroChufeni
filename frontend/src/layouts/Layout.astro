---
import '../styles/global.css';

const {
    title = 'RamaTech'
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="Tienda de productos de informática" />
        <title>{title}</title>
    </head>

    <body class="min-h-screen bg-gray-100 text-gray-900">
        <slot />
    </body>
</html>
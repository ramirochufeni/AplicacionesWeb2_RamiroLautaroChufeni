---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Carrito from '../components/Carrito.astro';
---

<Layout title="Carrito - RamaTech">
    <Header />

    <main class="max-w-6xl mx-auto px-4 py-10">
        <div class="mb-8">
            <h1 class="text-4xl font-bold">
                Mi carrito
            </h1>

            <p class="text-gray-600 mt-2">
                Revisá los productos antes de realizar la compra.
            </p>
        </div>

        <Carrito />
    </main>
</Layout>